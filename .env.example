# Local-only credentials. Never commit real values.
# Copy to a location outside the repository (e.g. ~/.config/cgi-erp/) and export before running probes.
# Example: set -a; . ~/.config/cgi-erp/ecount.env; set +a
ECOUNT_COM_CODE=
ECOUNT_USER_ID=
ECOUNT_API_CERT_KEY=
# Non-secret ERP mapping/settings. Keep the switch off until ECOUNT codes are approved.
ECOUNT_ORDER_SYNC_ENABLED=NO
ECOUNT_TARGET=test
ECOUNT_DEFAULT_CUST_CODE=
ECOUNT_DEFAULT_WH_CD=
ECOUNT_ITEM_CODE_MAP_JSON={}
ECOUNT_SHIPPING_ITEM_CODE=
NAVER_ID=
NAVER_PW=
PLAYWRIGHT_MODULE=
