# Local-only credentials. Never commit real values.
# Copy to a location outside the repository (e.g. ~/.config/cgi-erp/) and export before running probes.
# Example: set -a; . ~/.config/cgi-erp/ecount.env; set +a
ECOUNT_COM_CODE=
ECOUNT_USER_ID=
ECOUNT_PASSWORD=
NAVER_ID=
NAVER_PW=
PLAYWRIGHT_MODULE=
